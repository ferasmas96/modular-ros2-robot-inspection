<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="generic_16ch_gpu_lidar" params="
    name parent_link topic_base
    samples_h min_ang_h max_ang_h min_ang_v max_ang_v
    update_rate min_range max_range range_resolution
    *origin">
    <link name="${name}_link"/>

    <joint name="${name}_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="${name}_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <gazebo reference="${name}_link">
      <sensor name="${name}_gpu_lidar" type="gpu_lidar">
        <always_on>true</always_on>
        <update_rate>${update_rate}</update_rate>
        <visualize>true</visualize>
        <gz_frame_id>${name}_link</gz_frame_id>
        <topic>${topic_base}</topic>
        <lidar>
          <scan>
            <horizontal>
              <samples>${samples_h}</samples>
              <resolution>1</resolution>
              <min_angle>${min_ang_h}</min_angle>
              <max_angle>${max_ang_h}</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>${min_ang_v}</min_angle>
              <max_angle>${max_ang_v}</max_angle>
            </vertical>
          </scan>
          <range>
            <min>${min_range}</min>
            <max>${max_range}</max>
            <resolution>${range_resolution}</resolution>
          </range>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- Temporary synthetic values for static integration; not manufacturer specifications. -->
  <xacro:generic_16ch_gpu_lidar
      name="helios_16p"
      parent_link="top_plate_default_mount"
      topic_base="/a300_00000/sensors/helios_16p"
      samples_h="360"
      min_ang_h="-3.141592653589793"
      max_ang_h="3.141592653589793"
      min_ang_v="-0.2617993877991494"
      max_ang_v="0.2617993877991494"
      update_rate="10"
      min_range="0.1"
      max_range="20.0"
      range_resolution="0.01">
    <origin xyz="0.0 0.0 0.10" rpy="0.0 0.0 0.0"/>
  </xacro:generic_16ch_gpu_lidar>
</robot>
