<?xml version="1.0"?>
<package format="3">
  <name>husky_a300_sensor_extensions</name>
  <version>0.1.0</version>
  <description>Project-owned Husky A300 sensor extensions and PointCloud2 timing adapter.</description>
  <maintainer email="maintainer@example.org">Project Maintainer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
